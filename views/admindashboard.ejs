<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/admin.css">
</head>

<body>
    <h2>hi admin </h2>
    <h3>users</h3>

 

    <table>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
                        <th>Password</th>

        </tr>
                    <% search.forEach(element=> { %>
